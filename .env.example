# LLM — set the keys for whichever providers you use
GROQ_API_KEY=gsk_...
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
FIREWORKS_API_KEY=fw_...

# Which provider to use by default: groq | openai | anthropic
LLM_PROVIDER=groq

# Override model (leave blank to use each provider's default)
LLM_MODEL=

# PostgreSQL — use postgresql+asyncpg:// for async driver
# Neon example: postgresql+asyncpg://user:pass@ep-xxx.neon.tech/dbname?sslmode=require
DB_URL=postgresql+asyncpg://user:password@localhost:5432/chatbot_db

# Redis — use rediss:// for TLS (Upstash), redis:// for local
REDIS_URL=redis://localhost:6379
REDIS_DEFAULT_TTL_SECONDS=3600

# API key protecting /query and /admin endpoints
API_KEY=change-me-to-a-long-random-secret

# ChromaDB (RAG vector store)
CHROMA_PERSIST_DIR=./rag/chroma_db
CHROMA_COLLECTION_NAME=schema_columns
RAG_TOP_K=5
